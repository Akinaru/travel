# Base de données locale : docker compose -f docker-compose.dev.yml up -d (port 5433)
DATABASE_URL=postgres://voyages:voyages@localhost:5433/voyages

# Auth : générer avec `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Connexion Google (optionnel : le bouton est masqué si vide)
# Redirect URI à déclarer chez Google : ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dossier des documents uploadés (volume persistant en prod)
UPLOAD_DIR=./data/uploads
